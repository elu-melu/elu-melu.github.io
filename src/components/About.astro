---
import { Image } from "astro:assets";
import { siteConfig, interests, education, photos } from "../data/siteData";
import portrait from "../assets/photos/portrait.jpg";
---

<section id="about" class="pt-section">
  <div class="max-w-page mx-auto px-gutter grid lg:grid-cols-12 gap-x-6">
    <div class="lg:col-span-3 lg:sticky lg:top-20 self-start mb-8 lg:mb-0">
      <h2 class="text-title">About</h2>
    </div>
    <div class="lg:col-span-9 min-w-0 grid md:grid-cols-9 gap-x-6 gap-y-10 items-start">
      <div class="md:col-span-6 min-w-0">
        <p class="text-lead">{siteConfig.bio}</p>

        <h3 class="text-small font-semibold mt-12 mb-4">Education</h3>
        <ul class="divide-y divide-line">
          {education.map((edu) => (
            <li class="grid sm:grid-cols-[9.5rem_minmax(0,1fr)] gap-x-6 gap-y-1 py-5 first:pt-0">
              <p class="text-meta text-muted num sm:pt-1">{edu.date}</p>
              <div class="min-w-0">
                <p class="text-heading">{edu.school}</p>
                <p class="text-ink-2 mt-1">{edu.degree}{edu.focus && `, ${edu.focus}`}{edu.minor && `, minor in ${edu.minor}`}</p>
              </div>
            </li>
          ))}
        </ul>

        <h3 class="text-small font-semibold mt-12 mb-4">Talk to me about</h3>
        <p class="text-body text-ink-2 max-w-measure">
          {interests.map((i) => i.label).join(", ")}.
        </p>
      </div>

      <figure class="md:col-span-3 md:mt-24 w-40 md:w-full ml-auto md:ml-0 min-w-0">
        <Image src={portrait} alt={photos.about.alt} widths={[400, 700, 934]} sizes="(min-width: 768px) 25vw, 160px" class="w-full h-auto rounded-md shadow-rest" />
        <figcaption class="text-meta text-muted mt-3">{photos.about.caption}</figcaption>
      </figure>
    </div>
  </div>
</section>
