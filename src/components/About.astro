---
import { siteConfig, interests, education, affiliations } from "../data/siteData";
---

<section id="about" class="py-24 bg-pale-teal">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="font-mono text-4xl md:text-5xl text-deep-teal mb-2 section-reveal">About</h2>
    <div class="w-12 h-[2px] bg-deep-teal mb-12 section-reveal"></div>

    <div class="grid md:grid-cols-2 gap-12">
      <div class="section-reveal">
        <p class="text-charcoal text-lg leading-relaxed mb-8">{siteConfig.bio}</p>
        <div class="flex flex-wrap gap-3">
          {affiliations.map((a) => (
            <a
              href={a.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm bg-deep-teal text-white px-4 py-2 hover:bg-charcoal transition-colors"
            >
              {a.name}
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          ))}
        </div>
      </div>

      <div class="space-y-10 section-reveal">
        <div>
          <h3 class="text-deep-teal text-sm font-semibold uppercase tracking-wider mb-4">Education</h3>
          {education.map((edu) => (
            <div class="mb-5 last:mb-0">
              <p class="font-semibold text-charcoal">{edu.school}</p>
              <p class="text-charcoal/85">{edu.degree}{edu.focus && `, ${edu.focus}`}{edu.minor && `, minor in ${edu.minor}`}</p>
              <p class="text-sm text-deep-teal mt-1">{edu.date}</p>
            </div>
          ))}
        </div>

        <div>
          <h3 class="text-deep-teal text-sm font-semibold uppercase tracking-wider mb-4">Talk to me about</h3>
          <ul class="flex flex-wrap gap-2">
            {interests.map((item) => (
              <li class="text-sm border border-deep-teal/40 text-deep-teal px-3 py-1.5">{item.label}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
