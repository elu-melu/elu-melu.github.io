---
import { Image } from "astro:assets";
import SectionHead from "./SectionHead.astro";
import { siteConfig, interests, education, photos } from "../data/siteData";
import sofa from "../assets/photos/sofa.jpg";
---

<section id="about" class="py-16 md:py-24 bg-paper-deep">
  <div class="max-w-6xl mx-auto px-6">
    <SectionHead number="IV" title="About" />
    <div class="grid md:grid-cols-12 gap-12 items-start">
      <div class="md:col-span-7 section-reveal">
        <p class="drop-cap text-xl md:text-2xl leading-relaxed mb-10">{siteConfig.bio}</p>

        <h3 class="kicker text-teal mb-4">Education</h3>
        <ul class="space-y-4 mb-10">
          {education.map((edu) => (
            <li>
              <p class="font-display text-2xl leading-tight">{edu.school}</p>
              <p>{edu.degree}{edu.focus && `, ${edu.focus}`}{edu.minor && `, minor in ${edu.minor}`}</p>
              <p class="font-sans text-sm text-muted">{edu.date}</p>
            </li>
          ))}
        </ul>

        <h3 class="kicker text-teal mb-4">Talk to me about</h3>
        <p class="font-display italic text-2xl leading-snug">
          {interests.map((i) => i.label).join(", ")}.
        </p>
      </div>

      <figure class="md:col-span-5 max-w-sm w-full mx-auto rotate-[-1.5deg] section-reveal">
        <div class="print">
          <Image src={sofa} alt={photos.about.alt} widths={[400, 700, 1000]} sizes="(min-width: 768px) 384px, 90vw" class="w-full h-auto" />
        </div>
        <figcaption class="font-display italic text-lg text-muted mt-3 text-center">{photos.about.caption}</figcaption>
      </figure>
    </div>
  </div>
</section>
