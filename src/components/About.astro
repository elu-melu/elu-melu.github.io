---
import { ArrowRight } from "@lucide/vue";
import { siteConfig } from "../data/siteData";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section id="about" class="pt-section">
  <div class="max-w-page mx-auto px-gutter grid lg:grid-cols-12 gap-x-6">
    <div class="lg:col-span-3 lg:sticky lg:top-20 self-start mb-8 lg:mb-0">
      <h2 class="text-title">About</h2>
      <p class="text-meta text-muted num mt-2">{siteConfig.location}</p>
    </div>
    <div class="lg:col-span-9 min-w-0 max-w-measure">
      <p class="text-body text-ink">{siteConfig.bio}</p>
      <a href={`${base}/cv/`} class="link text-small font-[560] inline-flex items-center gap-1.5 mt-8">
        The formal CV
        <ArrowRight size={16} stroke-width={1.5} aria-hidden="true" class="i-fwd" />
      </a>
    </div>
  </div>
</section>
