---
import { siteConfig, links } from "../data/siteData";
import Footer from "./Footer.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const social = [
  { href: links.linkedin, label: "LinkedIn" },
  { href: links.github, label: "GitHub" },
  { href: links.scholar, label: "Google Scholar" },
  { href: links.labackdoor, label: "LaBackDoor" },
];
---

<section id="contact" class="py-20 md:py-32 bg-ink text-paper">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="font-display text-6xl md:text-8xl leading-[0.95] mb-8">
      Write <em>to me.</em>
    </h2>
    <p class="text-xl text-paper/85 max-w-xl mb-10">{siteConfig.seeking}</p>

    <div class="flex flex-wrap gap-4 font-sans text-sm mb-14">
      <a href={`mailto:${siteConfig.email}`} class="bg-paper text-ink font-medium px-6 py-3 hover:bg-sky transition-colors">Send email</a>
      <button id="copy-email" type="button" class="border border-paper font-medium px-6 py-3 hover:bg-paper hover:text-ink transition-colors">
        Copy email
      </button>
      <a href={`${base}/${siteConfig.resume}`} class="border border-paper font-medium px-6 py-3 hover:bg-paper hover:text-ink transition-colors">
        Download resume
      </a>
    </div>
    <p id="copy-status" class="sr-only" aria-live="polite"></p>

    <ul class="flex flex-wrap gap-x-8 gap-y-3 font-sans text-sm border-t border-paper/25 pt-6">
      {social.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer" class="text-paper/85 hover:text-rust-light underline-offset-4 hover:underline">
            {s.label} ↗<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
<Footer />

<script define:vars={{ email: siteConfig.email }}>
  const btn = document.getElementById("copy-email");
  const status = document.getElementById("copy-status");
  btn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(email);
      btn.textContent = "Copied";
      if (status) status.textContent = "Email address copied";
    } catch {
      btn.textContent = email;
    }
    setTimeout(() => {
      btn.textContent = "Copy email";
    }, 2000);
  });
</script>
