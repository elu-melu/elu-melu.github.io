---
import { ArrowRight, ArrowUpRight, Check, Copy } from "@lucide/vue";
import { siteConfig, links } from "../data/siteData";
import Footer from "./Footer.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const social = [
  { href: links.linkedin, label: "LinkedIn" },
  { href: links.github, label: "GitHub" },
  { href: links.scholar, label: "Google Scholar" },
  { href: links.labackdoor, label: "LaBackDoor" },
];
---

<section id="contact" class="on-ink mt-section bg-ink text-ground relative overflow-hidden">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(60rem_32rem_at_0%_0%,rgb(107_82_135/0.38),transparent_70%)]"></div>
  <div class="relative max-w-page mx-auto px-gutter py-section">
    <h2 class="text-title">Write to me.</h2>
    <a
      href={`mailto:${siteConfig.email}`}
      class="block mt-6 text-[clamp(1.25rem,5.6vw,4.5rem)] leading-none tracking-[-0.035em] font-[560] break-all hover:text-accent-light transition-colors duration-150"
    >{siteConfig.email}</a>
    <p class="text-lead text-on-ink-muted max-w-measure mt-8">
      If you want to build something, edit something, or argue about a film, write to me.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <button id="copy-email" type="button" class="btn btn-primary">
        <span data-icon="copy" class="inline-flex"><Copy size={16} stroke-width={1.5} aria-hidden="true" /></span>
        <span data-icon="check" class="hidden"><Check size={16} stroke-width={1.5} aria-hidden="true" /></span>
        <span data-label>Copy email</span>
      </button>
      <a href={`${base}/cv/`} class="btn">
        Read the CV
        <ArrowRight size={16} stroke-width={1.5} aria-hidden="true" class="i-fwd" />
      </a>
    </div>
    <p id="copy-status" class="sr-only" aria-live="polite"></p>

    <ul class="mt-block pt-6 border-t border-ground/15 flex flex-wrap gap-x-8 gap-y-3 text-small">
      {social.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer" class="text-on-ink-muted hover:text-ground transition-colors duration-150 inline-flex items-center gap-1 min-h-11">
            {s.label}
            <ArrowUpRight size={16} stroke-width={1.5} aria-hidden="true" class="i-out" />
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
<Footer />

<script define:vars={{ email: siteConfig.email }}>
  const btn = document.getElementById("copy-email");
  const status = document.getElementById("copy-status");
  const label = btn?.querySelector("[data-label]");
  const copyIcon = btn?.querySelector("[data-icon=copy]");
  const checkIcon = btn?.querySelector("[data-icon=check]");

  function showCopied(copied) {
    copyIcon?.classList.toggle("hidden", copied);
    checkIcon?.classList.toggle("hidden", !copied);
    if (label) label.textContent = copied ? "Copied" : "Copy email";
  }

  btn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(email);
      showCopied(true);
      if (status) status.textContent = "Email address copied";
    } catch {
      if (label) label.textContent = email;
    }
    setTimeout(() => showCopied(false), 2000);
  });
</script>
