---
import { siteConfig, links } from "../data/siteData";
---

<section id="contact" class="py-24 bg-charcoal">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <h2 class="font-mono text-3xl md:text-4xl text-white mb-2 section-reveal">
      contact
    </h2>
    <div class="w-12 h-[2px] bg-teal mx-auto mb-8 section-reveal"></div>
    <p class="text-white/60 max-w-lg mx-auto mb-12 section-reveal">
      Open to collaboration, research opportunities, and interesting conversations.
      Feel free to reach out.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12 section-reveal">
      <a
        href={`mailto:${siteConfig.email}`}
        class="inline-block border border-teal text-teal px-8 py-3 text-sm font-mono tracking-wider hover:bg-teal hover:text-charcoal transition-all duration-300"
      >
        send email
      </a>
      <button
        id="copy-email"
        class="inline-block border border-white/20 text-white/60 px-8 py-3 text-sm font-mono tracking-wider hover:border-teal hover:text-teal transition-all duration-300"
      >
        copy email
      </button>
    </div>

    <div class="flex items-center justify-center gap-6 section-reveal">
      <a
        href={links.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="text-white/40 hover:text-teal transition-colors text-sm font-mono"
      >
        linkedin
      </a>
      <span class="text-white/20">|</span>
      <a
        href={links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-white/40 hover:text-teal transition-colors text-sm font-mono"
      >
        github
      </a>
      <span class="text-white/20">|</span>
      <a
        href={links.labackdoor}
        target="_blank"
        rel="noopener noreferrer"
        class="text-white/40 hover:text-teal transition-colors text-sm font-mono"
      >
        labackdoor
      </a>
    </div>
  </div>
</section>

<footer class="bg-deep-teal py-6">
  <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between">
    <p class="font-mono text-white/40 text-xs">
      &copy; {new Date().getFullYear()} {siteConfig.handle}
    </p>
    <p class="font-mono text-white/30 text-xs mt-2 sm:mt-0">
      built with astro + vue
    </p>
  </div>
</footer>

<script define:vars={{ email: siteConfig.email }}>
  const btn = document.getElementById("copy-email");
  btn?.addEventListener("click", async () => {
    await navigator.clipboard.writeText(email);
    btn.textContent = "copied!";
    setTimeout(() => {
      btn.textContent = "copy email";
    }, 2000);
  });
</script>
