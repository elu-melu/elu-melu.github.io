---
import { ArrowRight, ArrowUpRight } from "@lucide/vue";
import { links } from "../data/siteData";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section id="selected" class="pt-section">
  <div class="max-w-page mx-auto px-gutter">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 mb-block">
      <h2 class="text-title">Selected</h2>
      <p class="text-meta text-muted">Asked, chosen.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-4">
      <a
        href={`${base}/work/dangote-ipo/`}
        class="lit md:col-span-2 p-6 md:p-10 grid md:grid-cols-12 gap-x-6 gap-y-6 items-end"
      >
        <div class="md:col-span-5 min-w-0">
          <p class="text-meta text-muted num">01 / Asked</p>
          <p class="text-figure num mt-4">2.79M</p>
          <p class="text-meta text-muted num mt-3">shares sold, 14 Sep to 27 Oct 2026</p>
        </div>
        <div class="md:col-span-7 min-w-0">
          <h3 class="text-headline text-[clamp(1.75rem,3.6vw,3rem)]">The platform behind the Dangote IPO</h3>
          <p class="text-ink-2 max-w-measure mt-4">
            An open offer that grew from Nigeria-only to the diaspora. I built the client side, owned the admin panel and
            designed the deployments that let different brokers run on it.
          </p>
          <span class="link text-small font-[560] inline-flex items-center gap-1.5 mt-6">
            Read the case study
            <ArrowRight size={16} stroke-width={1.5} aria-hidden="true" class="i-fwd" />
          </span>
        </div>
      </a>

      <a
        href={links.labackdoor}
        target="_blank"
        rel="noopener noreferrer"
        data-chip="labackdoor"
        class="lit p-6 md:p-8 flex flex-col md:col-span-2"
      >
        <p class="text-meta text-muted num">02 / Chosen</p>
        <h3 class="text-title mt-4">Teaching an agent to fix what it finds</h3>
        <p class="text-ink-2 max-w-measure mt-4">
          At LaBackDoor, we're building an AI that finds and remediates real software vulnerabilities. The published work
          started with forecasting them; the agent is the part that has to act.
        </p>
        <span class="link text-small font-[560] inline-flex items-center gap-1.5 mt-auto pt-8">
          LaBackDoor
          <ArrowUpRight size={16} stroke-width={1.5} aria-hidden="true" class="i-out" />
          <span class="sr-only"> (opens in a new tab)</span>
        </span>
      </a>
    </div>
  </div>
</section>
