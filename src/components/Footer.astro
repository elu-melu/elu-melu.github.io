---
import { siteConfig } from "../data/siteData";
---

<footer class="on-ink bg-ink text-on-ink-muted">
  <div class="max-w-page mx-auto px-gutter py-6 flex flex-wrap justify-between gap-2 text-meta num border-t border-ground/15">
    <p>&copy; {new Date().getFullYear()} {siteConfig.name}</p>
    <a href={`mailto:${siteConfig.email}`} class="hover:text-ground transition-colors duration-150">{siteConfig.email}</a>
  </div>
</footer>
