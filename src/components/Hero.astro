---
import { siteConfig } from "../data/siteData";
---

<section
  id="hero"
  class="relative min-h-screen flex items-center justify-center bg-charcoal overflow-hidden"
>
  <div class="absolute inset-0 bg-gradient-to-b from-charcoal via-charcoal to-deep-teal opacity-80"></div>

  <!-- Grid pattern overlay -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: repeating-linear-gradient(0deg, #fff 0px, #fff 1px, transparent 1px, transparent 60px), repeating-linear-gradient(90deg, #fff 0px, #fff 1px, transparent 1px, transparent 60px);"></div>

  <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
    <p class="font-mono text-teal text-lg md:text-xl mb-4 hero-fade" style="--delay: 0">
      hello, i'm
    </p>
    <h1 class="font-mono text-white text-5xl md:text-7xl lg:text-8xl font-bold tracking-tight mb-6 hero-fade" style="--delay: 1">
      {siteConfig.name.split(" ")[0].toLowerCase()}
    </h1>
    <div class="w-16 h-[2px] bg-teal mx-auto mb-6 hero-fade" style="--delay: 2"></div>
    <p class="text-white/60 text-lg md:text-xl max-w-2xl mx-auto mb-8 hero-fade" style="--delay: 3">
      {siteConfig.title}
    </p>
    <p class="text-white/40 text-sm font-mono hero-fade" style="--delay: 4">
      {siteConfig.location}
    </p>
    <div class="mt-12 hero-fade" style="--delay: 5">
      <a
        href="#about"
        class="inline-block border border-teal text-teal px-8 py-3 text-sm tracking-wider hover:bg-teal hover:text-charcoal transition-all duration-300"
      >
        explore
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 hero-fade" style="--delay: 6">
    <div class="w-[1px] h-12 bg-gradient-to-b from-teal to-transparent animate-pulse"></div>
  </div>
</section>

<style>
  .hero-fade {
    opacity: 0;
    transform: translateY(20px);
    animation: heroFadeIn 0.8s ease-out forwards;
    animation-delay: calc(0.3s + var(--delay) * 0.15s);
  }

  @keyframes heroFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
