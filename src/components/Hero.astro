---
import { Image } from "astro:assets";
import { Download } from "@lucide/vue";
import { siteConfig, photos } from "../data/siteData";
import cover from "../assets/photos/bucket-hat.jpg";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section id="hero" class="pt-16 md:pt-24 pb-block">
  <div class="max-w-page mx-auto px-gutter">
    <h1 class="text-display animate-settle -ml-[0.04em]">Webster<br />Elumelu</h1>

    <div class="grid lg:grid-cols-12 gap-x-6 mt-10 md:mt-16">
      <div class="lg:col-start-4 lg:col-span-6">
        <p class="text-lead text-ink-2 max-w-measure">{siteConfig.tagline}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#work" class="btn btn-primary">View work</a>
          <a href={`${base}/${siteConfig.resume}`} class="btn">
            Download resume
            <Download size={16} stroke-width={1.5} aria-hidden="true" />
          </a>
        </div>
      </div>

      <figure class="lg:col-start-11 lg:col-span-2 lg:-mt-40 mt-12 w-36 lg:w-full ml-auto">
        <Image
          src={cover}
          alt={photos.cover.alt}
          widths={[200, 400]}
          sizes="(min-width: 1024px) 180px, 144px"
          loading="eager"
          class="w-full h-auto rounded-md shadow-rest"
        />
        <figcaption class="text-meta text-muted mt-3">{photos.cover.caption}</figcaption>
      </figure>
    </div>
  </div>
</section>
