---
// A slow band of words between sections. It is decorative, so screen readers
// skip it, and it stops moving for readers who ask for reduced motion.
const words = ["Payments", "AI security", "Research", "Editing", "Photography", "Design", "International politics", "Mathematics", "Film"];
const run = [...words, ...words];
---

<div class="border-y border-ink overflow-hidden py-4 bg-paper" aria-hidden="true">
  <div class="marquee flex w-max">
    {[0, 1].map(() => (
      <ul class="flex shrink-0 items-center">
        {run.map((w) => (
          <li class="flex items-center font-display italic text-3xl md:text-4xl whitespace-nowrap px-6">
            {w}<span class="ml-12 size-1.5 rounded-full bg-rust" aria-hidden="true"></span>
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .marquee {
    animation: marquee 80s linear infinite;
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee { animation: none; }
  }
</style>
