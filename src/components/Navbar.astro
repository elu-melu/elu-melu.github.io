---
import { Menu, X } from "@lucide/vue";
import { siteConfig } from "../data/siteData";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const nav = [
  { href: `${base}/#work`, label: "Work" },
  { href: `${base}/#publications`, label: "Publications" },
  { href: `${base}/#off-the-clock`, label: "Off the clock" },
  { href: `${base}/#about`, label: "About" },
  { href: `${base}/#contact`, label: "Contact" },
];
---

<header class="sticky top-0 z-50 bg-ground border-b border-line">
  <nav class="max-w-page mx-auto px-gutter h-14 flex items-center justify-between" aria-label="Main">
    <a href={`${base}/`} class="text-[0.9375rem] font-semibold tracking-[-0.011em] text-ink">
      {siteConfig.name}
    </a>
    <div class="hidden md:flex items-center gap-7 text-small">
      {nav.map((n) => (
        <a href={n.href} class="text-ink-2 hover:text-ink transition-colors duration-150 focus-visible:text-ink">{n.label}</a>
      ))}
      <a href={`${base}/${siteConfig.resume}`} class="btn min-h-9 px-3.5">
        Resume
      </a>
    </div>
    <button
      id="menu-toggle"
      type="button"
      class="md:hidden size-11 -mr-2.5 grid place-items-center text-ink-2 hover:text-accent transition-colors duration-150 active:scale-[0.97]"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span id="menu-icon-open" aria-hidden="true"><Menu size={22} stroke-width={1.5} /></span>
      <span id="menu-icon-close" class="hidden" aria-hidden="true"><X size={22} stroke-width={1.5} /></span>
    </button>
  </nav>
  <div id="mobile-menu" class="md:hidden max-h-0 overflow-hidden transition-[max-height] duration-[240ms] ease-[var(--ease-out)] bg-ground">
    <div class="px-gutter py-2 flex flex-col text-body border-t border-line">
      {nav.map((n) => (
        <a href={n.href} class="py-3 text-ink-2 hover:text-ink">{n.label}</a>
      ))}
      <a href={`${base}/${siteConfig.resume}`} class="link py-3">Resume (PDF)</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");

  function setOpen(open: boolean) {
    if (!menu || !toggle) return;
    menu.style.maxHeight = open ? `${menu.scrollHeight}px` : "0";
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
  }

  toggle?.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
</script>
