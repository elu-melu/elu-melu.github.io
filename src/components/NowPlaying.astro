---
import { ArrowUpRight } from "@lucide/vue";
import { links } from "../data/siteData";
import spotify from "../data/spotify.json";

type Track = {
  id: string;
  name: string;
  artists: string[];
  album: string;
  image: string;
  url: string;
  playedAt: string;
};

const latest = ((spotify.tracks ?? []) as Track[])[0];
const endpoint = links.nowPlaying;
---

{
  latest && (
    <div
      class="lg:col-start-1 lg:col-span-3 lg:row-start-1 mt-10 lg:mt-1 max-w-sm"
      data-listening
      data-endpoint={endpoint}
    >
      <a
        data-live
        href={latest.url}
        target="_blank"
        rel="noopener noreferrer"
        class="block rounded-md border border-line bg-surface p-3.5 shadow-rest transition-colors duration-150 hover:border-line-strong"
      >
        <span class="flex h-3.5 items-center justify-between gap-3">
          <span data-live-heading class="text-meta text-muted">Last played</span>
          <span class="flex h-3.5 shrink-0 items-end gap-[3px]" aria-hidden="true" data-live-eq hidden>
            <span class="eq-bar" />
            <span class="eq-bar" />
            <span class="eq-bar" />
            <span class="eq-bar" />
          </span>
        </span>

        <span class="mt-3 flex items-center gap-3.5">
          <img
            data-live-art
            src={latest.image}
            alt=""
            width="56"
            height="56"
            loading="lazy"
            class="size-14 shrink-0 rounded-xs object-cover"
          />
          <span class="min-w-0 flex-1">
            <span data-live-title class="block truncate text-small font-[560]">{latest.name}</span>
            <span data-live-meta class="mt-0.5 block truncate text-meta text-muted num">
              {[latest.artists.join(", "), latest.album].filter(Boolean).join(" · ")}
            </span>
          </span>
        </span>

        <span data-live-progress-wrap class="mt-3.5 block" hidden>
          <span class="block h-0.5 overflow-hidden rounded-full bg-line">
            <span
              data-live-progress
              class="block h-full w-0 rounded-full bg-accent transition-[width] duration-1000 ease-linear"
            />
          </span>
          <span class="mt-1.5 flex justify-between text-meta text-muted num">
            <span data-live-elapsed>0:00</span>
            <span data-live-duration>0:00</span>
          </span>
        </span>

        <span class="sr-only"> (opens Spotify in a new tab)</span>
      </a>

      <a
        href={links.spotify}
        target="_blank"
        rel="noopener noreferrer"
        class="link text-meta mt-2.5 inline-flex items-center gap-1"
      >
        Spotify
        <ArrowUpRight size={13} stroke-width={1.5} aria-hidden="true" class="i-out" />
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>
  )
}

<script>
  import { accentFromImage } from "../lib/albumColor";

  // Live "now playing" from the Worker. Everything above is the fallback: if the
  // endpoint is unset, slow, or rejects, the card keeps the last-played track.
  const listening = document.querySelector<HTMLElement>("[data-listening]");
  const live = listening?.querySelector<HTMLAnchorElement>("[data-live]");
  const endpoint = listening?.dataset.endpoint;

  if (listening && live && endpoint) {
    const art = live.querySelector<HTMLImageElement>("[data-live-art]");
    const title = live.querySelector<HTMLElement>("[data-live-title]");
    const meta = live.querySelector<HTMLElement>("[data-live-meta]");
    const heading = live.querySelector<HTMLElement>("[data-live-heading]");
    const eq = live.querySelector<HTMLElement>("[data-live-eq]");
    const wrap = live.querySelector<HTMLElement>("[data-live-progress-wrap]");
    const bar = live.querySelector<HTMLElement>("[data-live-progress]");
    const elapsed = live.querySelector<HTMLElement>("[data-live-elapsed]");
    const duration = live.querySelector<HTMLElement>("[data-live-duration]");

    type Track = {
      id: string;
      name: string;
      artists: string[];
      album: string;
      image: string;
      url: string;
      durationMs: number;
      progressMs: number;
    };

    let track: Track | null = null;
    let startedAt = 0;
    let ticker = 0;
    let poller = 0;
    let visible = false;
    let tintRun = 0;

    const clock = (ms: number) => {
      const seconds = Math.max(0, Math.floor(ms / 1000));
      return `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`;
    };

    // Advance the progress locally so it moves between the 30 s polls.
    const paint = () => {
      if (!track) return;
      const at = Math.min(track.durationMs, track.progressMs + Date.now() - startedAt);
      if (bar) bar.style.width = track.durationMs > 0 ? `${(at / track.durationMs) * 100}%` : "0%";
      if (elapsed) elapsed.textContent = clock(at);
      if (duration) duration.textContent = clock(track.durationMs);
    };

    const show = (next: Track) => {
      track = next;
      startedAt = Date.now();
      if (art) {
        if (next.image) art.src = next.image;
        art.classList.toggle("hidden", !next.image);
      }
      if (title) title.textContent = next.name;
      if (meta) meta.textContent = [next.artists.join(", "), next.album].filter(Boolean).join(" · ");
      if (next.url) live.href = next.url;

      // Tint the bars and progress fill from the cover, never blocking the reveal.
      const run = ++tintRun;
      live.style.removeProperty("--np");
      if (next.image) {
        accentFromImage(next.image)
          .then((shade) => {
            if (shade && run === tintRun) live.style.setProperty("--np", shade);
          })
          .catch(() => {
            // keep the site accent
          });
      }

      if (!ticker) {
        ticker = window.setInterval(paint, 1000);
        if (heading) heading.textContent = "Now playing";
        eq?.removeAttribute("hidden");
        wrap?.removeAttribute("hidden");
      }
      paint();
    };

    const poll = async () => {
      try {
        const res = await fetch(endpoint, { cache: "no-store", signal: AbortSignal.timeout(6000) });
        if (!res.ok) return;
        const data = (await res.json()) as { configured?: boolean; isPlaying?: boolean; track?: Track | null };
        if (!data.configured || !data.isPlaying || !data.track) return;
        show(data.track);
      } catch {
        // Unreachable endpoint: keep the last-played track.
      }
    };

    const sync = () => {
      window.clearInterval(poller);
      poller = 0;
      if (!visible || document.visibilityState === "hidden") return;
      void poll();
      poller = window.setInterval(poll, 30_000);
    };

    // Only poll while the card is on screen.
    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        sync();
      },
      { rootMargin: "200px" },
    ).observe(listening);

    document.addEventListener("visibilitychange", sync);
  }
</script>

<style>
  .eq-bar {
    width: 2px;
    height: 4px;
    border-radius: 999px;
    background: var(--np, var(--color-accent));
    transform-origin: bottom;
    animation: eq 0.9s ease-in-out infinite;
  }
  .eq-bar:nth-child(2) {
    animation-duration: 0.7s;
    animation-delay: 0.12s;
  }
  .eq-bar:nth-child(3) {
    animation-duration: 1.1s;
    animation-delay: 0.24s;
  }
  .eq-bar:nth-child(4) {
    animation-duration: 0.8s;
    animation-delay: 0.06s;
  }

  [data-live] [data-live-progress] {
    background: var(--np, var(--color-accent));
  }

  @keyframes eq {
    0%,
    100% {
      height: 30%;
    }
    50% {
      height: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .eq-bar {
      animation: none;
      height: 60%;
    }
  }
</style>
