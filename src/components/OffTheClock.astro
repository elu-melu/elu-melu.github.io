---
import { getCollection } from "astro:content";
import { ArrowRight, ArrowUpRight, RefreshCw } from "@lucide/vue";
import { getFilms, hasThoughts } from "../lib/films";
import { bareMax, links } from "../data/siteData";
import spotify from "../data/spotify.json";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const books = (await getCollection("books")).sort((a, b) => {
  if (a.data.status !== b.data.status) return a.data.status === "reading" ? -1 : 1;
  const t = (b.data.finished?.getTime() ?? 0) - (a.data.finished?.getTime() ?? 0);
  return t !== 0 ? t : (a.data.order ?? 0) - (b.data.order ?? 0);
});
const films = await getFilms();
const recent = (spotify.tracks ?? []) as { id: string; name: string; artists: string[]; album: string; image: string; url: string; playedAt: string }[];
const latest = recent[0];
const played = (iso: string) => new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short" });
const year = films[0]?.data.seen ?? new Date().getFullYear();
const filmsThisYear = films.filter((f) => f.data.seen === year);
// Pinned films (featured: 1-5) show in that order. With none pinned, five are
// picked at random on each visit; without JavaScript the five newest show.
const pinned = filmsThisYear.filter((f) => f.data.featured).sort((a, b) => a.data.featured! - b.data.featured!);
const randomise = pinned.length === 0;
const filmPreview = randomise ? filmsThisYear : pinned;
---

<section id="off-the-clock" class="pt-section">
  <div class="max-w-page mx-auto px-gutter">
    <div class="grid lg:grid-cols-12 gap-x-6 mb-block">
      <h2 class="lg:col-span-3 lg:sticky lg:top-20 self-start text-title mb-8 lg:mb-0">Off the clock</h2>
      <div class="lg:col-span-9 min-w-0">
        <p class="text-meta text-muted mb-3">{bareMax.role}</p>
        <a href={links.bareMax} target="_blank" rel="noopener noreferrer" class="text-headline font-light text-ink hover:text-accent transition-colors duration-150 inline-flex items-baseline gap-3">
          Bare Max
          <ArrowUpRight size={28} stroke-width={1.5} aria-hidden="true" class="i-out" />
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
        <p class="text-lead text-ink-2 max-w-measure mt-6">{bareMax.body}</p>
      </div>
    </div>

    {(books.length > 0 || filmsThisYear.length > 0 || links.spotify) && (
      <div class="grid md:grid-cols-3 gap-x-6 gap-y-12 pt-8 border-t border-line">
        {books.length > 0 && (
          <div class="min-w-0">
            <h3 class="text-small font-semibold text-ink mb-5">Reading</h3>
            <ul class="space-y-5">
              {books.map((b) => (
                <li>
                  <p class="text-body font-[560] leading-snug">{b.data.title}</p>
                  {(b.data.author || b.data.status === "reading") && (
                    <p class="text-meta text-muted num mt-0.5">
                      {[b.data.author, b.data.status === "reading" && "reading now"].filter(Boolean).join(", ")}
                    </p>
                  )}
                  {b.data.note && <p class="text-small text-ink-2 font-normal mt-1">{b.data.note}</p>}
                </li>
              ))}
            </ul>
          </div>
        )}

        {filmsThisYear.length > 0 && (
          <div class="min-w-0">
            <div class="flex items-center justify-between gap-4 mb-5">
              <h3 class="text-small font-semibold text-ink num">
                {filmsThisYear.length} films in {year}{randomise && <span class="text-muted font-normal">, five at random</span>}
              </h3>
              {randomise && (
                <span data-film-shuffle-wrap class="hidden">
                  <button
                    type="button"
                    data-film-shuffle
                    class="size-11 -m-3 grid place-items-center rounded-full text-ink-2 hover:text-accent active:scale-[0.97] transition duration-150"
                    aria-label="Show five other films"
                    title="Show five other films"
                  >
                    <RefreshCw size={18} stroke-width={1.5} aria-hidden="true" class="shuffle-icon" />
                  </button>
                </span>
              )}
            </div>
            <p class="sr-only" aria-live="polite" data-film-status></p>
            <ul class="space-y-5" data-film-list data-random={randomise ? "" : undefined}>
              {filmPreview.map((f, i) => (
                <li data-film class:list={[randomise && i >= 5 && "hidden"]}>
                  <p class="text-body font-[560] leading-snug">
                    {hasThoughts(f) ? (
                      <a href={`${base}/watching/${f.id}/`} class="link">{f.data.title}</a>
                    ) : (
                      f.data.title
                    )}
                  </p>
                  {(f.data.director || f.data.year) && (
                    <p class="text-meta text-muted num mt-0.5">{[f.data.director, f.data.year].filter(Boolean).join(", ")}</p>
                  )}
                  {f.data.note && <p class="text-small text-ink-2 font-normal mt-1">{f.data.note}</p>}
                  {hasThoughts(f) && (
                    <a href={`${base}/watching/${f.id}/`} class="link text-small inline-flex items-center gap-1.5 mt-2">
                      My thoughts
                      <ArrowRight size={16} stroke-width={1.5} aria-hidden="true" class="i-fwd" />
                    </a>
                  )}
                </li>
              ))}
            </ul>
            <a href={`${base}/watching/`} class="link text-small inline-flex items-center gap-1.5 mt-6">
              All {films.length} films
              <ArrowRight size={16} stroke-width={1.5} aria-hidden="true" class="i-fwd" />
            </a>
          </div>
        )}

        {links.spotify && (
          <div class="min-w-0">
            <h3 class="text-small font-semibold text-ink mb-5">{latest ? "Last played" : "Listening"}</h3>
            {latest && (
              <>
                <iframe
                  title={`Spotify player: ${latest.name} by ${latest.artists.join(", ")}`}
                  src={`https://open.spotify.com/embed/track/${latest.id}?theme=0`}
                  width="100%"
                  height="80"
                  loading="lazy"
                  allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                  class="rounded-md mb-6 border-0"
                ></iframe>
                <ul class="space-y-4 mb-6">
                  {recent.map((t) => (
                    <li>
                      <a href={t.url} target="_blank" rel="noopener noreferrer" class="group grid grid-cols-[2.75rem_minmax(0,1fr)] gap-3 items-center min-h-11">
                        {t.image ? (
                          <img src={t.image} alt="" width="44" height="44" loading="lazy" class="size-11 rounded-xs shadow-rest object-cover" />
                        ) : (
                          <span class="size-11 rounded-xs bg-sunken" />
                        )}
                        <span class="min-w-0">
                          <span class="block text-small font-[560] group-hover:text-accent transition-colors duration-150">{t.name}</span>
                          <span class="block text-meta text-muted num">{t.artists.join(", ")}, {played(t.playedAt)}</span>
                          <span class="sr-only"> (opens Spotify in a new tab)</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )}
            <a href={links.spotify} target="_blank" rel="noopener noreferrer" class:list={[latest ? "link text-small inline-flex items-center gap-1.5" : "link text-body"]}>
              {latest ? "My Spotify profile" : "On Spotify"}
              <ArrowUpRight size={16} stroke-width={1.5} aria-hidden="true" class="i-out" />
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </div>
        )}
      </div>
    )}
  </div>
</section>

<script>
  const list = document.querySelector<HTMLElement>("[data-film-list][data-random]");
  const button = document.querySelector<HTMLButtonElement>("[data-film-shuffle]");
  const wrap = document.querySelector<HTMLElement>("[data-film-shuffle-wrap]");
  const status = document.querySelector<HTMLElement>("[data-film-status]");

  if (list) {
    const items = [...list.querySelectorAll<HTMLElement>("[data-film]")];
    let current = new Set<number>();

    // Pick five films, never repeating the five already on screen when
    // there are enough films to avoid it.
    const shuffle = () => {
      const pool = items.map((_, i) => i).filter((i) => items.length - current.size < 5 || !current.has(i));
      const next = new Set<number>();
      while (next.size < Math.min(5, pool.length)) next.add(pool[Math.floor(Math.random() * pool.length)]);
      items.forEach((el, i) => el.classList.toggle("hidden", !next.has(i)));
      current = next;
    };

    shuffle();
    if (button) {
      wrap?.classList.remove("hidden");
      button.addEventListener("click", () => {
        shuffle();
        button.classList.remove("spin");
        void button.offsetWidth; // restart the animation
        button.classList.add("spin");
        if (status) status.textContent = "Showing five other films.";
      });
    }
  }
</script>

<style>
  .spin :global(.shuffle-icon) {
    animation: shuffle-spin 0.5s var(--ease-out);
  }
  @keyframes shuffle-spin {
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .spin :global(.shuffle-icon) { animation: none; }
  }
</style>
