---
import SectionHead from "./SectionHead.astro";
import { publications, links } from "../data/siteData";
const published = publications.filter((p) => p.status === "published");
const review = publications.filter((p) => p.status === "under review");
---

<section id="publications" class="py-16 md:py-24 bg-paper-deep">
  <div class="max-w-6xl mx-auto px-6">
    <SectionHead title="Publications" />
    <div class="grid md:grid-cols-12 gap-10">
      <div class="md:col-span-8">
        <p class="kicker text-muted mb-6">Published</p>
        <ol class="space-y-8 mb-14">
          {published.map((p, i) => (
            <li class="grid grid-cols-[2.5rem_1fr]">
              <span class="font-display text-3xl text-rust leading-none">{i + 1}</span>
              <div>
                <p class="font-display text-2xl md:text-3xl leading-tight">{p.title}</p>
                <p class="font-sans text-sm text-muted mt-2">{p.venue}, {p.year}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="kicker text-muted mb-6">Under review</p>
        <ul class="space-y-4">
          {review.map((p) => <li class="text-lg leading-snug">{p.title}</li>)}
        </ul>
      </div>
      <aside class="md:col-span-4 md:border-l border-rule md:pl-8">
        <p class="font-display italic text-2xl leading-snug mb-4">
          Vulnerability forecasting, access control, and benchmarks for AI agents that fix real-world vulnerabilities.
        </p>
        <a href={links.scholar} target="_blank" rel="noopener noreferrer" class="font-sans text-sm font-medium text-rust link">
          Google Scholar ↗<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </aside>
    </div>
  </div>
</section>
