---
import { ArrowUpRight } from "@lucide/vue";
import { publications, links } from "../data/siteData";
const published = publications.filter((p) => p.status === "published");
const review = publications.filter((p) => p.status === "under review");
const papers = [...published, ...review];
---

<section id="publications" class="pt-section">
  <div class="max-w-page mx-auto px-gutter grid lg:grid-cols-12 gap-x-6">
    <div class="lg:col-span-3 lg:sticky lg:top-20 self-start mb-8 lg:mb-0">
      <h2 class="text-title">Publications</h2>
    </div>
    <div class="lg:col-span-9 min-w-0">
      <p class="text-lead max-w-measure">
        Vulnerability forecasting, access control, and benchmarks for AI agents that fix real-world vulnerabilities.
      </p>
      <a href={links.scholar} target="_blank" rel="noopener noreferrer" class="link text-small inline-flex items-center gap-1.5 mt-4">
        Google Scholar
        <ArrowUpRight size={16} stroke-width={1.5} aria-hidden="true" class="i-out" />
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
      <ol class="divide-y divide-line mt-12">
        {papers.map((p) => {
          const isPublished = p.status === "published";
          return (
            <li class="grid grid-cols-[5.5rem_minmax(0,1fr)] gap-x-6 py-6 first:pt-0">
              {isPublished ? (
                <span class="text-meta num text-ink pt-1">{p.year}</span>
              ) : (
                <span class="text-meta text-muted pt-1">In review</span>
              )}
              <div class="min-w-0">
                <p class:list={["text-heading", isPublished ? "text-ink font-[560]" : "text-ink-2 font-[450]"]}>{p.title}</p>
                {isPublished && <p class="text-small text-muted mt-1.5">{p.venue}</p>}
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>
