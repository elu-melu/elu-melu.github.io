---
interface Props {
  number: string;
  title: string;
  id?: string;
}
const { number, title } = Astro.props;
---

<div class="flex items-baseline gap-4 border-t border-ink pt-4 mb-12 section-reveal">
  <span class="font-display italic text-3xl md:text-4xl text-rust leading-none">{number}.</span>
  <h2 class="font-display text-5xl md:text-6xl leading-none">{title}</h2>
</div>
