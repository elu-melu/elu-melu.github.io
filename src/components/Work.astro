---
import SectionHead from "./SectionHead.astro";
import { experience, projects, skills } from "../data/siteData";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section id="work" class="py-16 md:py-24">
  <div class="max-w-6xl mx-auto px-6">
    <SectionHead number="I" title="Work" />

    <ol class="divide-y divide-rule border-b border-rule mb-20">
      {experience.map((job) => (
        <li class="grid md:grid-cols-12 gap-x-8 gap-y-2 py-8 section-reveal">
          <div class="md:col-span-3 font-sans text-sm text-muted pt-1">
            <p>{job.date}</p>
            {job.location && <p>{job.location}</p>}
          </div>
          <div class="md:col-span-9">
            <h3 class="font-display text-3xl leading-tight">{job.role}</h3>
            <p class="kicker text-teal mt-2 mb-4">{job.company}</p>
            <ul class="space-y-2 max-w-2xl">
              {job.bullets.map((b) => (
                <li class="pl-5 relative before:content-['—'] before:absolute before:left-0 before:text-muted">{b}</li>
              ))}
            </ul>
            {job.caseStudy && (
              <a href={`${base}/${job.caseStudy.href}`} class="inline-block mt-5 font-sans text-sm font-medium text-rust link">
                {job.caseStudy.label} →
              </a>
            )}
          </div>
        </li>
      ))}
    </ol>

    <a
      href={`${base}/work/dangote-ipo/`}
      class="group block bg-ink text-paper p-8 md:p-12 mb-20 section-reveal hover:bg-teal transition-colors"
    >
      <p class="kicker text-rust-light mb-4">Feature</p>
      <p class="font-display text-4xl md:text-6xl leading-[1.02] max-w-3xl mb-6">
        The platform behind 2.79&nbsp;million Dangote IPO shares
      </p>
      <p class="text-paper/85 max-w-2xl mb-6">
        An open offer that grew from Nigeria-only to the diaspora. I built the client side, owned the admin panel and
        designed the deployments that let different brokers run on it.
      </p>
      <span class="font-sans text-sm font-medium underline underline-offset-4">Read the case study →</span>
    </a>

    <div class="flex items-baseline justify-between border-t border-ink pt-4 mb-10 section-reveal">
      <h3 class="font-display text-4xl">Selected projects</h3>
    </div>
    <div class="grid md:grid-cols-2 gap-x-12 mb-20">
      {projects.map((project) => (
        <article class="border-t border-rule py-8 section-reveal">
          <h4 class="font-display text-3xl leading-tight mb-3">{project.title}</h4>
          <p class="mb-3">{project.description}</p>
          <ul class="text-muted text-base mb-4">
            {project.highlights.map((h) => <li>{h}</li>)}
          </ul>
          <p class="font-sans text-xs text-muted mb-4">{project.tech.join(" · ")}</p>
          {project.link && (
            <a href={project.link} target="_blank" rel="noopener noreferrer" class="font-sans text-sm font-medium text-rust link">
              {project.linkLabel ?? "View project"} ↗<span class="sr-only"> for {project.title} (opens in a new tab)</span>
            </a>
          )}
        </article>
      ))}
    </div>

    <div class="border-t border-ink pt-4 section-reveal">
      <h3 class="font-display text-4xl mb-8">Toolkit</h3>
      <dl class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {Object.entries(skills).map(([category, items]) => (
          <div>
            <dt class="kicker text-teal mb-3">{category}</dt>
            {items.map((skill) => <dd>{skill}</dd>)}
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
