---
import { Image } from "astro:assets";
import SectionHead from "./SectionHead.astro";
import { experience, projects, skills } from "../data/siteData";
import rove10 from "../assets/work/rove10-sign-in.jpg";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section id="work" class="py-16 md:py-24">
  <div class="max-w-6xl mx-auto px-6">
    <SectionHead title="Work" />

    <ol class="divide-y divide-rule border-b border-rule mb-20">
      {experience.map((job) => (
        <li class="grid md:grid-cols-12 gap-x-8 gap-y-2 py-8">
          <div class="md:col-span-3 font-sans text-sm text-muted pt-1">
            <p>{job.date}</p>
            {job.location && <p>{job.location}</p>}
          </div>
          <div class="md:col-span-9">
            <h3 class="font-display text-3xl leading-tight">{job.role}</h3>
            <p class="font-sans text-base text-teal mt-2 mb-4">{job.company}</p>
            <ul class="space-y-2 max-w-2xl">
              {job.bullets.map((b) => (
                <li class="pl-5 relative before:content-['—'] before:absolute before:left-0 before:text-muted">{b}</li>
              ))}
            </ul>
            {job.caseStudy && (
              <a href={`${base}/${job.caseStudy.href}`} class="inline-block mt-5 font-sans text-sm font-medium text-rust link">
                {job.caseStudy.label} →
              </a>
            )}
          </div>
        </li>
      ))}
    </ol>

    <figure class="mb-20">
      <a href="https://app.rove10.com" target="_blank" rel="noopener noreferrer" class="block border border-rule hover:border-ink transition-colors">
        <Image
          src={rove10}
          alt="The Rove10 sign-in page: a welcome-back login form beside a photo of a professional working on a laptop"
          widths={[700, 1100, 1418]}
          sizes="(min-width: 1152px) 1104px, 92vw"
          class="w-full h-auto"
        />
        <span class="sr-only">Rove10 merchant app (opens in a new tab)</span>
      </a>
      <figcaption class="font-sans text-sm text-muted mt-3">
        Rove10, sign-in page. <a href="https://app.rove10.com" target="_blank" rel="noopener noreferrer" class="link">Open it ↗<span class="sr-only"> (opens in a new tab)</span></a>
      </figcaption>
    </figure>

    <a
      href={`${base}/work/dangote-ipo/`}
      class="group block bg-ink text-paper p-8 md:p-12 mb-20 hover:bg-teal transition-colors"
    >
      <p class="font-display text-4xl md:text-6xl leading-[1.02] max-w-3xl mb-6">
        The platform behind 2.79&nbsp;million Dangote IPO shares
      </p>
      <p class="text-paper/85 max-w-2xl mb-6">
        An open offer that grew from Nigeria-only to the diaspora. I built the client side, owned the admin panel and
        designed the deployments that let different brokers run on it.
      </p>
      <span class="font-sans text-sm font-medium underline underline-offset-4">Read the case study →</span>
    </a>

    <div class="flex items-baseline justify-between border-t border-ink pt-4 mb-2">
      <h3 class="font-display text-4xl">Index of projects</h3>
      <p class="font-sans text-sm text-muted">{projects.length} projects</p>
    </div>
    <ol class="mb-20">
      {projects.map((project, i) => {
        const Tag = project.link ? "a" : "div";
        return (
          <li class="border-b border-rule">
            <Tag
              {...(project.link ? { href: project.link, target: "_blank", rel: "noopener noreferrer" } : {})}
              class:list={["grid grid-cols-[2.5rem_1fr] md:grid-cols-[3rem_minmax(0,5fr)_minmax(0,7fr)_4rem] gap-x-6 gap-y-1 py-6 items-baseline", project.link && "group hover:bg-paper-deep transition-colors"]}
            >
              <span class="font-sans text-sm text-muted">{String(i + 1).padStart(2, "0")}</span>
              <span class="font-display text-3xl leading-tight group-hover:text-rust transition-colors">{project.title}</span>
              <span class="col-start-2 md:col-start-auto">
                <span class="block">{project.description}</span>
                <span class="block font-sans text-xs text-muted mt-2">{project.tech.join(" · ")}</span>
              </span>
              <span class="col-start-2 md:col-start-auto font-sans text-sm font-medium text-rust">
                {project.link ? <>Code ↗<span class="sr-only"> for {project.title} (opens in a new tab)</span></> : ""}
              </span>
            </Tag>
          </li>
        );
      })}
    </ol>

    <div class="border-t border-ink pt-4">
      <h3 class="font-display text-4xl mb-8">Toolkit</h3>
      <dl class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {Object.entries(skills).map(([category, items]) => (
          <div>
            <dt class="kicker text-teal mb-3">{category}</dt>
            {items.map((skill) => <dd>{skill}</dd>)}
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
