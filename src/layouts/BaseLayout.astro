---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Webster Elumelu — Software Engineer & Security Specialist",
  description = "Portfolio of Webster C. Elumelu. Software Engineer, Cybersecurity Specialist, and MS Computer Science candidate at Georgia Tech.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <slot />
  </body>
</html>
