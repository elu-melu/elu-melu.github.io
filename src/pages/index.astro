---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Work from "../components/Work.astro";
import Publications from "../components/Publications.astro";
import OffTheClock from "../components/OffTheClock.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
---

<BaseLayout>
  <a href="#work" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:bg-ink focus:text-paper focus:px-4 focus:py-2">Skip to content</a>
  <Navbar />
  <main>
    <Hero />
    <Work />
    <Publications />
    <OffTheClock />
    <About />
    <Contact />
  </main>
</BaseLayout>
