---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { ArrowLeft } from "@lucide/vue";
import { getFilms, hasThoughts } from "../../lib/films";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const films = await getFilms();
const byYear = new Map<number, typeof films>();
for (const f of films) {
  const y = f.data.seen;
  byYear.set(y, [...(byYear.get(y) ?? []), f]);
}
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "short" });
---

<BaseLayout title="Watching | Webster Elumelu" description="Films Webster Elumelu has watched, with notes and longer thoughts on some of them.">
  <a href="#watching" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-60 focus:bg-ink focus:text-ground focus:rounded-sm focus:px-4 focus:py-2">Skip to content</a>
  <Navbar />
  <main id="watching" class="flex-1 pt-16 md:pt-24 pb-section">
    <div class="max-w-page mx-auto px-gutter">
      <a href={`${base}/#off-the-clock`} class="link text-small inline-flex items-center gap-1.5">
        <ArrowLeft size={16} stroke-width={1.5} aria-hidden="true" class="i-back" />
        Off the clock
      </a>
      <h1 class="text-headline mt-10">Watching</h1>
      <p class="text-lead text-ink-2 max-w-measure mt-4 mb-block">
        <span class="num">{films.length} {films.length === 1 ? "film" : "films"}</span>, newest first. Violet titles open my longer thoughts.
      </p>

      {[...byYear.entries()].map(([year, list]) => (
        <section class="grid lg:grid-cols-12 gap-x-6 mb-block">
          <div class="lg:col-span-3 lg:sticky lg:top-20 self-start mb-4">
            <h2 class="text-title font-light num">{year}</h2>
            <p class="text-meta text-muted num mt-1">{list.length} {list.length === 1 ? "film" : "films"}</p>
          </div>
          <ol class="lg:col-span-9 min-w-0 divide-y divide-line">
            {list.map((f, i) => (
              <li class="grid grid-cols-[4.25rem_minmax(0,1fr)] sm:grid-cols-[5.5rem_minmax(0,1fr)] gap-x-4 py-4">
                <p class="text-meta text-muted num pt-1">{f.data.watched ? fmt(f.data.watched) : `No. ${list.length - i}`}</p>
                <div class="min-w-0">
                  <p class="text-body font-[560]">
                    {hasThoughts(f) ? (
                      <a href={`${base}/watching/${f.id}/`} class="link">{f.data.title}</a>
                    ) : (
                      f.data.title
                    )}
                  </p>
                  {(f.data.director || f.data.year) && (
                    <p class="text-meta text-muted num">{[f.data.director, f.data.year].filter(Boolean).join(", ")}</p>
                  )}
                  {f.data.note && <p class="text-small text-ink-2 font-normal mt-1">{f.data.note}</p>}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>
