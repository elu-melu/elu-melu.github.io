---
import { getFilms, hasThoughts } from "../../lib/films";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const films = await getFilms();
const byYear = new Map<number, typeof films>();
for (const f of films) {
  const y = f.data.seen;
  byYear.set(y, [...(byYear.get(y) ?? []), f]);
}
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "short" });
---

<BaseLayout title="Watching | Webster Elumelu" description="Films Webster Elumelu has watched, with notes and longer thoughts on some of them.">
  <a href="#watching" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-60 focus:bg-ink focus:text-paper focus:px-4 focus:py-2">Skip to content</a>
  <Navbar />
  <main id="watching" class="flex-1 pt-32 pb-24">
    <div class="max-w-4xl mx-auto px-6">
      <a href={`${base}/#off-the-clock`} class="font-sans text-sm text-rust link">← Off the clock</a>
      <h1 class="font-display text-6xl md:text-8xl leading-none mt-10 mb-4">Watching</h1>
      <p class="text-xl text-muted mb-14">{films.length} {films.length === 1 ? "film" : "films"}, newest first. Underlined titles open my longer thoughts.</p>

      {[...byYear.entries()].map(([year, list]) => (
        <section class="mb-16">
          <div class="flex items-baseline justify-between border-t border-ink pt-4 mb-2">
            <h2 class="font-display italic text-4xl">{year}</h2>
            <p class="font-sans text-sm text-muted">{list.length} {list.length === 1 ? "film" : "films"}</p>
          </div>
          <ol class="divide-y divide-rule">
            {list.map((f, i) => (
              <li class="grid grid-cols-[4.5rem_1fr] sm:grid-cols-[6rem_1fr] gap-4 py-5">
                <p class="font-sans text-sm text-muted pt-1.5">{f.data.watched ? fmt(f.data.watched) : `No. ${list.length - i}`}</p>
                <div>
                  <p class="font-display text-3xl leading-tight">
                    {hasThoughts(f) ? (
                      <a href={`${base}/watching/${f.id}/`} class="text-rust link"><em>{f.data.title}</em></a>
                    ) : (
                      <em>{f.data.title}</em>
                    )}
                  </p>
                  {(f.data.director || f.data.year) && (
                    <p class="font-sans text-sm text-muted">{[f.data.director, f.data.year].filter(Boolean).join(", ")}</p>
                  )}
                  {f.data.note && <p class="mt-1">{f.data.note}</p>}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>
