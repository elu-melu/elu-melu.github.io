---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import { siteConfig } from "../../data/siteData";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const role = [
  {
    title: "Client side",
    body: "Built the frontend investors used to take part in the offering.",
  },
  {
    title: "Admin panel",
    body: "Owned the admin panel end to end.",
  },
  {
    title: "API contracts",
    body: "Worked out the API contracts with the backend team.",
  },
  {
    title: "Multi-broker deployments",
    body: "Designed how the platform was deployed for multi-tenancy, so different brokers could run on it.",
  },
  {
    title: "A/B testing",
    body: "Ran A/B tests on the client side.",
  },
  {
    title: "Design system",
    body: "The design system was built by the engineers on the ground, and I did a large share of that work.",
  },
];
---

<BaseLayout
  title="Dangote IPO platform | Webster Elumelu"
  description="Case study: the platform Payaza used to sell shares in the Dangote IPO. Over 2.79 million shares, worth over NGN 1.46 billion, were sold through it between 14 September and 27 October 2026."
>
  <a href="#case-study" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:bg-teal focus:text-charcoal focus:px-4 focus:py-2">Skip to content</a>
  <Navbar />
  <main id="case-study" class="bg-charcoal pt-32 pb-24">
    <article class="max-w-3xl mx-auto px-6">
      <a href={`${base}/#work`} class="text-sm text-teal hover:text-light-teal underline underline-offset-4">← Back to work</a>

      <p class="text-teal font-medium mt-10 mb-3">Case study · 78 Financials (Payaza)</p>
      <h1 class="font-mono text-white text-5xl md:text-6xl leading-none mb-6">Dangote IPO platform</h1>
      <p class="text-white/85 text-xl leading-relaxed mb-12">
        The system Payaza used to sell shares in the Dangote IPO, from 14 September to 27 October 2026.
      </p>

      <dl class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-16">
        <div class="border-l-2 border-teal pl-4">
          <dt class="sr-only">Shares sold</dt>
          <dd class="text-white text-3xl font-semibold">2.79M+</dd>
          <dd class="text-white/70 text-sm mt-1">shares sold through the platform</dd>
        </div>
        <div class="border-l-2 border-teal pl-4">
          <dt class="sr-only">Value sold</dt>
          <dd class="text-white text-3xl font-semibold">₦1.46B+</dd>
          <dd class="text-white/70 text-sm mt-1">worth of shares sold</dd>
        </div>
        <div class="border-l-2 border-teal pl-4">
          <dt class="sr-only">Offering window</dt>
          <dd class="text-white text-3xl font-semibold">6 weeks</dd>
          <dd class="text-white/70 text-sm mt-1">14 Sep - 27 Oct 2026</dd>
        </div>
      </dl>

      <section class="mb-14">
        <h2 class="text-white text-2xl font-semibold mb-4">Context</h2>
        <div class="space-y-4 text-white/85 text-lg leading-relaxed">
          <p>
            The IPO was an open call to bring in as many investors as possible. It was first set up for investors
            in Nigeria only. Partway through, it opened to Nigerians and non-Nigerians in the diaspora, so the
            platform had to serve investors outside the country as well.
          </p>
        </div>
      </section>

      <section class="mb-14">
        <h2 class="text-white text-2xl font-semibold mb-6">My role</h2>
        <ul class="grid sm:grid-cols-2 gap-4">
          {role.map((r) => (
            <li class="border border-white/15 p-5">
              <h3 class="text-teal font-semibold mb-2">{r.title}</h3>
              <p class="text-white/85">{r.body}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="mb-16">
        <h2 class="text-white text-2xl font-semibold mb-4">Outcome</h2>
        <p class="text-white/85 text-lg leading-relaxed">
          Over 2.79 million shares, worth over NGN 1.46 billion, were sold through the platform during the
          offering window.
        </p>
      </section>

      <div class="flex flex-wrap gap-4">
        <a
          href={`${base}/${siteConfig.resume}`}
          class="inline-block bg-teal text-charcoal font-medium px-7 py-3 text-sm hover:bg-light-teal transition-colors"
        >
          Download resume
        </a>
        <a
          href={`mailto:${siteConfig.email}`}
          class="inline-block border border-teal text-teal font-medium px-7 py-3 text-sm hover:bg-teal hover:text-charcoal transition-colors"
        >
          Email me
        </a>
      </div>
    </article>
  </main>
  <footer class="bg-deep-teal py-6">
    <div class="max-w-3xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-2 text-sm">
      <p class="text-white/80">&copy; {new Date().getFullYear()} {siteConfig.name}</p>
      <a href={`mailto:${siteConfig.email}`} class="text-white/80 hover:text-white">{siteConfig.email}</a>
    </div>
  </footer>
</BaseLayout>
