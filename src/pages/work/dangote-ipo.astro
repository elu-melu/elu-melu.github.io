---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { siteConfig } from "../../data/siteData";
import { ArrowLeft, Download } from "@lucide/vue";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const role = [
  { title: "Client side", body: "Built the frontend investors used to take part in the offering." },
  { title: "Admin panel", body: "Owned the admin panel end to end." },
  { title: "API contracts", body: "Worked out the API contracts with the backend team." },
  { title: "Multi-broker deployments", body: "Designed how the platform was deployed for multi-tenancy, so different brokers could run on it." },
  { title: "A/B testing", body: "Ran A/B tests on the client side." },
  { title: "Design system", body: "The design system was built by the engineers on the ground, and I did a large share of that work." },
];
const facts = [
  { label: "Shares sold", value: "2.79M+" },
  { label: "Value sold", value: "NGN 1.46B+" },
  { label: "Offering window", value: "14 Sep to 27 Oct 2026, 6 weeks" },
];
---

<BaseLayout
  title="Dangote IPO platform | Webster Elumelu"
  description="Case study: the platform Payaza used to sell shares in the Dangote IPO. Over 2.79 million shares, worth over NGN 1.46 billion, were sold through it between 14 September and 27 October 2026."
>
  <a href="#case-study" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:bg-ink focus:text-ground focus:rounded-sm focus:px-4 focus:py-2">Skip to content</a>
  <Navbar />
  <main id="case-study" class="flex-1 pt-16 md:pt-24 pb-section">
    <article class="max-w-page mx-auto px-gutter">
      <a href={`${base}/#work`} class="link text-small inline-flex items-center gap-1.5">
        <ArrowLeft size={16} stroke-width={1.5} aria-hidden="true" class="i-back" />
        Back to work
      </a>

      <h1 class="text-headline mt-10 max-w-[16ch]">The Dangote IPO platform</h1>
      <p class="text-lead text-ink-2 max-w-measure mt-6">
        The system Payaza used to sell shares in the Dangote IPO, from 14 September to 27 October 2026.
      </p>

      <dl class="lit mt-block mb-block divide-y divide-line max-w-2xl">
        {facts.map((f) => (
          <div class="flex items-baseline justify-between gap-6 px-5 py-4">
            <dt class="text-small text-muted">{f.label}</dt>
            <dd class="text-heading num text-right">{f.value}</dd>
          </div>
        ))}
      </dl>

      <section class="grid lg:grid-cols-12 gap-x-6 mb-block">
        <h2 class="lg:col-span-3 text-title mb-4">Context</h2>
        <p class="lg:col-span-9 text-lead max-w-measure">
          The IPO was an open call to bring in as many investors as possible. It was first set up for investors in
          Nigeria only. Partway through, it opened to Nigerians and non-Nigerians in the diaspora, so the platform had
          to serve investors outside the country as well.
        </p>
      </section>

      <section class="grid lg:grid-cols-12 gap-x-6 mb-block">
        <h2 class="lg:col-span-3 text-title mb-4">My role</h2>
        <dl class="lg:col-span-9 min-w-0 divide-y divide-line">
          {role.map((r) => (
            <div class="grid sm:grid-cols-[14rem_minmax(0,1fr)] gap-x-6 gap-y-1 py-5 first:pt-0">
              <dt class="text-heading">{r.title}</dt>
              <dd class="text-ink-2">{r.body}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="grid lg:grid-cols-12 gap-x-6 mb-block">
        <h2 class="lg:col-span-3 text-title mb-4">Outcome</h2>
        <p class="lg:col-span-9 text-lead max-w-measure">
          Over <span class="num font-[560]">2.79 million</span> shares, worth over <span class="num font-[560]">NGN 1.46 billion</span>, were sold through the platform during the offering
          window.
        </p>
      </section>

      <div class="flex flex-wrap gap-3">
        <a href={`${base}/${siteConfig.resume}`} class="btn btn-primary">
          Download resume
          <Download size={16} stroke-width={1.5} aria-hidden="true" />
        </a>
        <a href={`mailto:${siteConfig.email}`} class="btn">Email me</a>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
